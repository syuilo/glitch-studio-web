{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
    "allowImportingTsExtensions": true,
		"strict": true,
		"strictFunctionTypes": true,
		"strictNullChecks": true,
		"noImplicitReturns": true,
		"verbatimModuleSyntax": true,
		"rootDir": "..",
		"paths": {
			"@/*": ["./*"]
		},
		"types": ["@webgpu/types"]
	},
	"include": [
		"@types/**/*.ts",
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"test/**/*"
	]
}
